# LLM provider switch:
#   NODE_ENV=production         → uses Anthropic Claude (requires ANTHROPIC_API_KEY)
#   NODE_ENV=development (or unset) → uses Groq Llama 70B (requires GROQ_API_KEY)
NODE_ENV=development

ANTHROPIC_API_KEY=your_anthropic_key_here
GROQ_API_KEY=

TARGET_BASE_URL=http://localhost:8000
TEST_DB_URL=postgresql://testuser:testpass@localhost:5432/testdb
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123
