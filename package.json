{
  "name": "test-forge",
  "version": "0.1.0",
  "description": "AI-powered test harness — reads your codebase, generates Supertest + Playwright tests via Claude",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "forge": "ts-node scripts/forge.ts",
    "test": "jest",
    "test:e2e": "playwright test generated/e2e",
    "test:api": "jest --testPathPattern=generated/api",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^17.4.2",
    "glob": "^10.3.0",
    "groq-sdk": "^0.7.0",
    "ora": "^8.0.1",
    "supertest": "^6.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/generated/api/**/*.test.ts",
      "**/tests/**/*.test.ts"
    ]
  }
}
